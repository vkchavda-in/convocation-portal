# ============================================================
# AM CoE Website — Production Environment Variables
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to your server as: .env
# 2. Fill in ALL values marked with <REPLACE_...>
# 3. Set this BEFORE running: pnpm build
# ============================================================

# Database — PostgreSQL
# Format: postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
# ⚠ If password has @ # & characters, encode them: %40 %23 %26
DATABASE_URL="postgresql://<REPLACE_DB_USER>:<REPLACE_DB_PASSWORD>@localhost:5432/am_guni_prod?schema=public"

# Admin Bootstrap Credentials
# Used ONLY for the very first login (auto-creates the first SUPER_ADMIN user in DB)
# After first login, manage users through the CMS Admin Panel
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="<REPLACE_STRONG_PASSWORD_MIN_16_CHARS>"

# JWT Secret — must be at least 32 characters
# Generate one on the server with: openssl rand -hex 32
JWT_SECRET="<REPLACE_WITH_OUTPUT_OF: openssl rand -hex 32>"

# App URL — your public domain (no trailing slash)
# ⚠ This is embedded into the build at compile time (NEXT_PUBLIC_)
# You MUST set this BEFORE running pnpm build
NEXT_PUBLIC_APP_URL="https://am.guni.ac.in"

# Base Path — set to "/demo" for subdirectory deployment, leave EMPTY for root domain
# ⚠ This is also embedded at build time — change requires a rebuild
# For /demo deployment:  NEXT_PUBLIC_BASE_PATH="/demo"
# For root deployment:   NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_BASE_PATH="/demo"
